
{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        // mpv.har（@mpv-ohos/mpv-arkts）要求 compatibleSdkVersion ≥ 24，
        // 低于此值 hvigor 拒绝依赖。本机 SDK 为 26.0.0(26)，API≥26 时
        // 该字段必须是 "26.0.0" 这种字符串格式。
        "compileSdkVersion": "26.0.0",
        "compatibleSdkVersion": "26.0.0",
        "targetSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        // 声网 RTM SDK 是 **bytecode HAR**（`metadata.byteCodeHar: true`），
        // 必须开启 `buildOption.strictMode.useNormalizedOHMUrl` 才能被
        // 依赖解析。不加会报：
        //   Bytecode HARs: [@shengwang/rtm-full] not supported
        //   when useNormalizedOHMUrl is not true.
        // 注意：该字段**不在** products 顶层（schema 会拒绝），
        // 正确位置是 products[].buildOption.strictMode。
        "buildOption": {
          "strictMode": {
            "useNormalizedOHMUrl": true,
          },
        },
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "profile"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}