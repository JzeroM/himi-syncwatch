     int64_t pts;
 
@@ -917,6 +1084,9 @@ int ff_mediacodec_dec_send(AVCodecContext *avctx, MediaCodecDecContext *s,
         return AVERROR_EOF;
     }
 
+    if (pkt->size && (ret = mediacodec_dovi_parse(avctx, s, pkt)) < 0)
+        return ret;
+
     while (offset < pkt->size || (need_draining && !s->draining)) {
         ssize_t index = s->current_input_buffer;
         if (index < 0) {
@@ -1042,6 +1212,7 @@ int ff_mediacodec_dec_receive(AVCodecContext *avctx, MediaCodecDecContext *s,
                 }
             }
 
+            mediacodec_dovi_attach(s, frame);
             s->output_buffer_count++;
             return 0;
         } else {
@@ -1142,6 +1313,8 @@ int ff_mediacodec_dec_close(AVCodecContext *avctx, MediaCodecDecContext *s)
         }
     }
 
+    mediacodec_dovi_clear(s);
+    ff_dovi_ctx_unref(&s->dovi_ctx);
     ff_mediacodec_dec_unref(s);
 
     return 0;
