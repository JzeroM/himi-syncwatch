index 6b9ef67db1..bd50aaf71c 100644
--- a/video/out/android_common.c
+++ b/video/out/android_common.c
@@ -16,13 +16,18 @@
  */
 
 #include <libavcodec/jni.h>
+#include <dlfcn.h>
+#include <stdint.h>
 #include <android/native_window_jni.h>
+#include <libplacebo/colorspace.h>
 
 #include "android_common.h"
 #include "common/msg.h"
 #include "misc/jni.h"
 #include "options/m_config.h"
 #include "vo.h"
+#include "video/out/gpu/context.h"
+#include "video/mp_image.h"
 
 struct vo_android_state {
     struct mp_log *log;
@@ -100,3 +105,34 @@ bool vo_android_surface_size(struct vo *vo, int *out_w, int *out_h)
     *out_h = h;
     return true;
 }
+
+void vo_android_set_buffer_data_space(ANativeWindow *window, int32_t data_space)
+{
+    if (!window)
+        return;
+#if __ANDROID_API__ >= 28
+    ANativeWindow_setBuffersDataSpace(window, data_space);
+#else
+    typedef int32_t (*set_data_space_fn)(ANativeWindow *, int32_t);
+    static set_data_space_fn set_data_space;
+    static bool resolved;
+    if (!resolved) {
+        resolved = true;
+        set_data_space = (set_data_space_fn)dlsym(
+            RTLD_DEFAULT, "ANativeWindow_setBuffersDataSpace");
+    }
+    if (set_data_space)
+        set_data_space(window, data_space);
+#endif
+}
+
+struct pl_color_space vo_android_preferred_csp(struct ra_ctx *ctx)
+{
+    const struct pl_color_space color = vo_get_current_params(ctx->vo).color;
+
+    if (color.transfer == PL_COLOR_TRC_PQ)
+        return pl_color_space_hdr10;
+    if (color.transfer == PL_COLOR_TRC_HLG)
+        return pl_color_space_bt2020_hlg;
+    return pl_color_space_srgb;
+}
