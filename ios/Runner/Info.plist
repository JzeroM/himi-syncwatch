<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>HIMI</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>himi_syncwatch</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>FlutterDeepLinkingEnabled</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>himi.trakt</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>himi</string>
			</array>
		</dict>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>声网实时消息需要麦克风权限</string>
	<key>NSCameraUsageDescription</key>
	<string>扫描二维码加入房间</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>从相册选择二维码图片加入房间</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- 备用应用图标（flutter_dynamic_icon_plus）：走 Asset Catalog appiconset
	     （Assets.xcassets/<id>.appiconset，由 tool/gen_icons.dart 生成），
	     Info.plist 仅用 CFBundleIconName 声明；配套 Xcode 构建设置
	     ASSETCATALOG_COMPILER_INCLUDE_ALL_APPICON_ASSETS = YES（见
	     scripts/configure_ios_icons.rb），否则备用 appiconset 不编进
	     Assets.car、setAlternateIconName 报 OSStatus -54。 -->
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconName</key>
			<string>AppIcon</string>
		</dict>
		<key>CFBundleAlternateIcons</key>
		<dict>
			<key>artistic</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>artistic</string>
			</dict>
			<key>glass</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>glass</string>
			</dict>
			<key>mint</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>mint</string>
			</dict>
		</dict>
	</dict>
	<key>CFBundleIcons~ipad</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconName</key>
			<string>AppIcon</string>
		</dict>
		<key>CFBundleAlternateIcons</key>
		<dict>
			<key>artistic</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>artistic</string>
			</dict>
			<key>glass</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>glass</string>
			</dict>
			<key>mint</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>mint</string>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
